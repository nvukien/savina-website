# Savina Website — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# EmailJS (https://www.emailjs.com/) — for Contact form submission
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Savina Backend API (Phase 1.D-bis)
# Local dev: http://localhost:8000/api
# Production: https://api.savina.vn/api
VITE_API_BASE=http://localhost:8000/api

# Analytics — leave empty to disable (no script loaded)
VITE_GA_ID=
VITE_GTM_ID=
VITE_GSC_VERIFY=
